# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://stocksense:stocksense@localhost:5432/stocksense

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=stocksense

# ─── SMTP (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@stocksense.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000    # 1 minute
RATE_LIMIT_MAX=100            # requests per window (global)
# Auth routes are always capped at 10 req / 15 min (hardcoded)

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Seed Script (optional overrides) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@stocksense.app
SEED_ADMIN_PASSWORD=Admin@12345
