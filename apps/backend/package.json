{
  "name": "@stocksense/backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockSense backend API — Express + TypeScript + Drizzle ORM",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/app.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "0.41.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.38.4",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "pg": "8.13.3",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.7",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.11",
    "@types/uuid": "10.0.0",
    "drizzle-kit": "0.30.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "@vitest/coverage-v8": "2.1.8"
  }
}
